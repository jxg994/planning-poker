{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev server",
      "type": "shell",
      "command": "npm run dev -- --port 5173 --strictPort",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^__never_matches__$" },
        "background": {
          "activeBegins": true,
          "beginsPattern": "VITE",
          "endsPattern": "Local:"
        }
      }
    },
    {
      "label": "stop dev server",
      "type": "shell",
      "command": "echo ${input:terminateDevServer}",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "terminateDevServer",
      "type": "command",
      "command": "workbench.action.tasks.terminate",
      "args": "dev server"
    }
  ]
}
